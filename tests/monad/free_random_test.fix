module FreeRandomTest;

import Minilib.Monad.FreeRandom::{FreeRandom, FreeRandom::interpret};
import Minilib.Monad.IO::{MonadIOFailIF::lift_iofail, MonadIOIF::lift_io};
import Minilib.Monad.Random::{MonadRandom, MonadRandomIF::{random_U64, random_bytes}};
import Minilib.Monad.State::eval_state_t;
import Minilib.Testing.UnitTest::{assert_true, make_test, run_test_driver, TestCase};
import Minilib.Trait.Traversable::map_m;
import Random::init_by_seed;
import Std::{
    Array, I64, IO, ToString, U64, U8, Array::@, IO::println, Iterator::{range, to_array}, Monad::pure, 
    ToString::to_string
};

type Item = unbox struct {
    u64val: U64,
    bytes: Array U8,
};

impl Item: ToString {
    to_string = |item| "Item" + (item.@u64val, item.@bytes).to_string;
}

generate_item: [m: MonadRandom] m Item;
generate_item = (
    pure $ Item {
        u64val: *random_U64,
        bytes: *random_bytes(4),
    }
);

generate_items: [m: MonadRandom] I64 -> m (Array Item);
generate_items = |size| (
    Iterator::range(0, size).to_array.map_m(|i| generate_item)
);

my_items: FreeRandom (Array Item);
my_items = generate_items(5);

test_free_random: TestCase;
test_free_random = (
    make_test("test_free_random") $ |_|

    let random = Random::init_by_seed(123_U64);
    do {
        let items = *my_items.interpret;
        println("items=" + items.to_string).lift_io;;
        // If equal accidentally, change random seed
        assert_true("u64val", items.@(0).@u64val != items.@(1).@u64val).lift_iofail;;
        pure()
    }.eval_state_t(random)
);

main: IO ();
main = (
    [
        test_free_random,
    ]
    .run_test_driver
);

